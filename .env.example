# Browser-safe Supabase project settings. These are intentionally NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only Scientific Sandbox model settings.
# Never expose OPENAI_API_KEY to the browser. OpenLab sets store:false on model calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional identification / higher-rate settings for official scientific APIs.
# The sandbox still works without these for light use.
NCBI_API_KEY=
NCBI_EMAIL=
CROSSREF_MAILTO=

# Commercial setup — these must NOT be set until the Stripe test-mode flow works.
# Private values: configure in Vercel Environment Variables, never commit real secrets.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO=false
# Only set true after sandbox payment, refund, portal and webhook replay tests.
OPENLAB_ENABLE_PAID_CHECKOUT=false
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_JUNIOR_PRICE_ID=
OPENLAB_SITE_URL=
OPENLAB_LEGAL_ENTITY=
OPENLAB_SUPPORT_EMAIL=
